# AI Embeddings
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
DASHSCOPE_MODEL=qwen-plus

# LLM fallback order.
# ollama: local model service, no paid cloud API required.
# openai_compatible: any free/local OpenAI-compatible /v1/chat/completions endpoint.
# retrieval: final no-model fallback that summarizes retrieved knowledge snippets.
LLM_FALLBACK_PROVIDERS=ollama,openai_compatible,retrieval

# Local Ollama fallback. Install Ollama, then run:
#   ollama pull qwen2.5:0.5b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
LOCAL_LLM_TIMEOUT_SECONDS=45

# Optional free/local OpenAI-compatible fallback.
# Examples: local LM Studio/vLLM/Ollama OpenAI server, or a provider with free quota.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Optional: Milvus Authentication (if enabled)
# MILVUS_USER=username
# MILVUS_PASSWORD=password

# Vector Store Selection (true for Milvus, false for FAISS)
# 默认使用 FAISS（零依赖，本地运行），需要生产级性能可切换 Milvus
USE_MILVUS=false
VECTOR_STORE_METRIC_TYPE=COSINE

# Vector Store Configuration
VECTOR_STORE_PERSIST_DIR=./faiss_index
VECTOR_STORE_COLLECTION_NAME=ai_knowledge_collection

# RAG safety configuration for medical/knowledge QA.
# In strict mode, professional answers require retrieved sources; otherwise the service asks for more information.
RAG_STRICT_MODE=true
RAG_SIMILARITY_THRESHOLD=0.68
RAG_TOP_K=5
RAG_USE_RERANK=true
RAG_MIN_SOURCE_COUNT=1

# Rerank Configuration
# Rerank type: 'bge' (recommended, local), 'cohere' (requires API key), 'simple' (fallback), 'none' (disabled)
# bge 效果最好但首次需下载 ~1.1GB 模型，开发环境建议用 simple
RERANKER_TYPE=simple

# Optional: Cohere API Key (if using Cohere reranker)
# COHERE_API_KEY=your_cohere_api_key

# Text Chunking Configuration
# Chunk strategy: 'semantic' (recommended), 'recursive' (default)
CHUNK_STRATEGY=semantic
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=100

# Conversation context and memory budgets
MEMORY_COMPRESS_THRESHOLD=10
MEMORY_KEEP_RECENT=6
MEMORY_MAX_MESSAGES=200
MEMORY_CONTEXT_MAX_CHARS=12000
MEMORY_HYDRATE_FROM_MYSQL=true
MEMORY_EXTRACT_USER_PREFERENCES=false
LLM_QUESTION_MAX_CHARS=9000
LLM_CONVERSATION_CONTEXT_MAX_CHARS=9000
LLM_KNOWLEDGE_CONTEXT_MAX_CHARS=12000
LLM_PROMPT_MAX_CHARS=32000

# Tesseract OCR Configuration
# Tesseract executable path（留空则自动检测常见安装路径）
TESSERACT_PATH=

# Temporary Files Configuration
TEMP_DIR=./temp

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8300

# MySQL Configuration
# python-service stores knowledge metadata, QA logs, agent runs and user memory here.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=doctor_care_platform
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
