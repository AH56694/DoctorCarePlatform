# Replace every placeholder. Provision private MySQL 8.4 and Redis before deployment.
DATABASE_URL=mysql+pymysql://doctorcare_app:replace-with-password@mysql.internal:3306/doctor_care_platform?charset=utf8mb4
DATABASE_MIGRATION_URL=mysql+pymysql://doctorcare_migrator:replace-with-password@mysql.internal:3306/doctor_care_platform?charset=utf8mb4
MYSQL_HOST=mysql.internal
MYSQL_PORT=3306
MYSQL_DATABASE=doctor_care_platform
MYSQL_USERNAME=doctorcare_ai
MYSQL_PASSWORD=replace-with-password
REDIS_URL=redis://:replace-with-password@redis.internal:6379/0
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
RAG_SERVICE_TOKEN=replace-with-another-independent-random-secret
CORS_ORIGINS=["https://care.example.com"]
AI_MODELS_DIR=./python-service/models/bge-small-zh-v1.5
LLM_FALLBACK_PROVIDERS=openai_compatible,retrieval
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Bounded consultation agent loop
AGENT_MAX_SEARCHES=3
AGENT_MAX_DECISIONS=6
AGENT_MAX_STEPS=24
AGENT_TIMEOUT_SECONDS=80
AGENT_STEP_TIMEOUT_SECONDS=20
