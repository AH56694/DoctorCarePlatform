APP_ENV=development
PROJECT_NAME=DoctorCarePlatform
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_TOKEN_EXPIRE_MINUTES=120
AUTH_ISSUER=doctor-care-platform

REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=doctor_care_platform
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
DATABASE_URL=mysql+pymysql://root:change-me@mysql:3306/doctor_care_platform?charset=utf8mb4
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=doctor-care-platform

RAG_SERVICE_URL=http://python-service:8300

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
DASHSCOPE_MODEL=qwen-plus
PYTHON_SERVICE_EMBEDDING_MODEL=local
LOCAL_EMBEDDING_MODEL_PATH=/app/models/bge-small-zh-v1.5
USE_MILVUS=false
VECTOR_STORE_METRIC_TYPE=COSINE
MEMORY_COMPRESS_THRESHOLD=10
MEMORY_KEEP_RECENT=6
MEMORY_MAX_MESSAGES=200
MEMORY_CONTEXT_MAX_CHARS=12000
MEMORY_HYDRATE_FROM_MYSQL=true
MEMORY_EXTRACT_USER_PREFERENCES=false
LLM_QUESTION_MAX_CHARS=9000
LLM_CONVERSATION_CONTEXT_MAX_CHARS=9000
LLM_KNOWLEDGE_CONTEXT_MAX_CHARS=12000
LLM_PROMPT_MAX_CHARS=32000
VECTOR_STORE_COLLECTION_NAME=doctorcare_medical_knowledge

ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
